ARG DEEPSTREAM_VERSION=9.1
ARG DEEPSTREAM_DEVEL_IMAGE=nvcr.io/nvidia/deepstream:$DEEPSTREAM_VERSION-triton-multiarch
ARG DEEPSTREAM_BASE_IMAGE=nvcr.io/nvidia/deepstream:$DEEPSTREAM_VERSION-samples-multiarch
FROM $DEEPSTREAM_DEVEL_IMAGE AS builder
ARG TARGETARCH

# prepare python build environment
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    python3-dev \
    python3-venv

RUN python3 -m venv /opt/venv --system-site-packages
ENV PATH="/opt/venv/bin:$PATH" \
    LD_LIBRARY_PATH=/opt/venv/lib:/opt/nvidia/deepstream/deepstream/lib:$LD_LIBRARY_PATH

RUN python3 -m pip install --no-cache-dir --upgrade \
    build \
    ninja \
    scikit-build

# install cmake
ARG CMAKE_VERSION=3.27.7
RUN if [ "$TARGETARCH" = "amd64" ]; then \
      wget -nv -O /tmp/cmake.sh https://github.com/Kitware/CMake/releases/download/v$CMAKE_VERSION/cmake-$CMAKE_VERSION-linux-x86_64.sh; \
      sh /tmp/cmake.sh --skip-license --prefix=/usr/local; \
      rm -f /tmp/cmake.sh; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
      wget -nv -O /tmp/cmake.sh https://github.com/Kitware/CMake/releases/download/v$CMAKE_VERSION/cmake-$CMAKE_VERSION-linux-aarch64.sh; \
      sh /tmp/cmake.sh --skip-license --prefix=/usr/local; \
      rm -f /tmp/cmake.sh; \
    fi

ARG L4T_VERSION=36.4
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      echo "deb [trusted=yes] https://repo.download.nvidia.com/jetson/t234 r${L4T_VERSION} main" \
        > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
      && rm /etc/ld.so.conf.d/nvidia-tegra.conf \
      && mkdir -p /opt/nvidia/l4t-packages/ \
      && touch /opt/nvidia/l4t-packages/.nv-l4t-disable-boot-fw-update-in-preinstall \
      && apt-get update \
      && apt-get install --no-install-recommends -y nvidia-l4t-multimedia; \
    fi

# extra packages builders
FROM builder AS extra-builder
# TODO: Move to r36.3+
FROM dustynv/l4t-pytorch:r36.2.0 AS extra-l4t-builder


# The DS 9.1 package store does not contain Savant's CUDA OpenCV build.
# Keep the 7.1 package path for Jetson Orin until its JetPack upgrade.
FROM builder AS opencv-package-builder
ARG TARGETARCH
ARG TARGETPLATFORM
ARG DEEPSTREAM_VERSION
ARG OPENCV_VERSION=4.12.0
ARG PACKAGES_URL=https://eu-central-1.linodeobjects.com/savant-data/packages/${TARGETPLATFORM}/ds${DEEPSTREAM_VERSION}
COPY libs/opencv/savant /tmp/opencv-savant
COPY utils/build_opencv.sh /tmp/build_opencv.sh
RUN if [ "$DEEPSTREAM_VERSION" = "9.1" ]; then \
      OPENCV_VERSION=4.14.0 \
        bash /tmp/build_opencv.sh /tmp/opencv-savant /tmp/opencv.tar.gz; \
    else \
      wget -nv -O /tmp/opencv.tar.gz \
        "${PACKAGES_URL}/opencv-${OPENCV_VERSION}-${TARGETARCH}-ds${DEEPSTREAM_VERSION}.tar.gz"; \
    fi


# NVIDIA no longer publishes PyDS wheels for DeepStream 9.x.
FROM builder AS pyds-package-builder
ARG TARGETARCH
ARG DEEPSTREAM_VERSION
ARG PYDS_SOURCE_REV=8ad0349ed7a496fae35ebb21c350641727070b89
RUN mkdir -p /tmp/pyds-dist && \
    if [ "$DEEPSTREAM_VERSION" = "9.1" ]; then \
      apt-get update && apt-get install --no-install-recommends -y \
        git g++ build-essential libglib2.0-dev libgstreamer1.0-dev && \
      git init /tmp/deepstream_python_apps && \
      cd /tmp/deepstream_python_apps && \
      git remote add origin https://github.com/NVIDIA-AI-IOT/deepstream_python_apps.git && \
      git fetch --depth 1 origin "$PYDS_SOURCE_REV" && \
      git checkout --detach FETCH_HEAD && \
      git submodule update --init bindings/3rdparty/pybind11 && \
      cd bindings && \
      CMAKE_ARGS="-DDS_PATH=/opt/nvidia/deepstream/deepstream" \
        CMAKE_BUILD_PARALLEL_LEVEL=4 python3 -m build --wheel && \
      cp dist/pyds-*.whl /tmp/pyds-dist/; \
    else \
      wget -nv -P /tmp/pyds-dist \
        https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.0/pyds-1.2.0-cp310-cp310-linux_aarch64.whl; \
    fi


# The released savant-rs DeepStream wheels link libcudart.so.12. Rebuild the
# two SDK-facing wheels against the CUDA 13 and DeepStream 9.1 headers.
FROM builder AS savant-rs-ds-builder
ARG DEEPSTREAM_VERSION
ARG SAVANT_RS_REV=7e9614f22d40030d305eeef868f6b85d6bfd524b
COPY docker/patches/savant-rs-deepstream-9.1.patch /tmp/savant-rs-deepstream-9.1.patch
ENV PATH="/root/.cargo/bin:$PATH" \
    CARGO_TARGET_DIR=/tmp/savant-rs-target \
    CARGO_BUILD_JOBS=4 \
    CARGO_INCREMENTAL=0
RUN set -eux; \
    mkdir -p /tmp/rs-ds-wheels; \
    if [ "$DEEPSTREAM_VERSION" = "9.1" ]; then \
      apt-get update; \
      apt-get install --no-install-recommends -y \
        clang libclang-dev build-essential pkg-config curl git \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        libgl-dev libegl-dev libfontconfig-dev fonts-dejavu-core; \
      curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh; \
      sh /tmp/rustup-init.sh -y --profile minimal; \
      python3 -m pip install --no-cache-dir 'maturin[patchelf]~=1.9'; \
      git init /tmp/savant-rs; \
      cd /tmp/savant-rs; \
      git remote add origin https://github.com/insight-platform/savant-rs.git; \
      git fetch --depth 1 origin "$SAVANT_RS_REV"; \
      git checkout --detach FETCH_HEAD; \
      git apply /tmp/savant-rs-deepstream-9.1.patch; \
      maturin build --release --interpreter python3 \
        --manifest-path savant_deepstream/deepstream_nvbufsurface/Cargo.toml \
        --out /tmp/rs-ds-wheels; \
      maturin build --release --interpreter python3 \
        --manifest-path savant_deepstream/deepstream_encoders/Cargo.toml \
        --out /tmp/rs-ds-wheels; \
    fi


# Savant python package builder
FROM builder AS savant-package-builder

WORKDIR /tmp/build
COPY pyproject.toml README.md LICENSE ./
COPY requirements/base.txt requirements/base.txt

RUN --mount=type=bind,source=savant,target=/tmp/savant \
    --mount=type=bind,source=utils/copy_code.sh,target=/tmp/copy_code.sh \
    /tmp/copy_code.sh /tmp/savant /tmp/build/savant

RUN python3 -m build --wheel


# Savant GStreamer/DeepStream meta package builder
FROM builder AS savant-meta-builder

WORKDIR /libs/gstsavantframemeta
COPY libs/gstsavantframemeta/requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt

# install savant-rs
ARG SAVANT_RS_VERSION
ARG SAVANT_RS_GH_REPO=insight-platform/savant-rs
ARG SAVANT_RS_GH_TOKEN
RUN --mount=type=bind,source=local_wheels,target=local_wheels \
    --mount=type=bind,source=utils/install_savant_rs.py,target=utils/install_savant_rs.py \
    ./utils/install_savant_rs.py $SAVANT_RS_VERSION ./tmp && rm -rf ./tmp

COPY libs/gstsavantframemeta .
RUN python3 -m build --wheel --no-isolation && rm -rf _skbuild


# Package builder for NvBufSurfaceGenerator
FROM builder AS nv-buf-surface-generator-builder

WORKDIR /libs/nvbufsurfacegenerator
COPY libs/nvbufsurfacegenerator/requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt

COPY libs/nvbufsurfacegenerator .
RUN python3 -m build --wheel --no-isolation && rm -rf _skbuild


# Savant boost(cuda) library builder
FROM builder AS savant-boost-builder

WORKDIR /libs/savantboost
COPY libs/savantboost/requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt

COPY libs/savantboost .
RUN python3 -m build --wheel --no-isolation && rm -rf _skbuild


# The GPU driver is injected only at container runtime. Use the CUDA link stub
# for build-time imports, then exercise the real driver in the GPU smoke check.
FROM builder AS cuda-link-stub
ARG TARGETARCH
ARG DEEPSTREAM_VERSION
RUN mkdir -p /tmp/cuda-stubs && \
    if [ "$DEEPSTREAM_VERSION" = "9.1" ] && [ "$TARGETARCH" = "amd64" ]; then \
      cp /usr/local/cuda/targets/x86_64-linux/lib/stubs/libcuda.so \
        /tmp/cuda-stubs/libcuda.so.1; \
    fi


# Savant base container
FROM $DEEPSTREAM_BASE_IMAGE AS base
ARG TARGETARCH
ARG TARGETPLATFORM
ARG DEEPSTREAM_VERSION
ARG PACKAGES_URL=https://eu-central-1.linodeobjects.com/savant-data/packages/${TARGETPLATFORM}/ds${DEEPSTREAM_VERSION}

# install base packages
RUN /opt/nvidia/deepstream/deepstream/user_additional_install.sh
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        file \
        gdb \
        strace \
        libmagic1 \
        libcairo2-dev \
        python3-pip \
        python3-venv \
        python3-dev \
        python-gi-dev \
        python3-gst-1.0 \
        gstreamer1.0-python3-plugin-loader && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ao-rtsp bug fix
RUN if [ "$TARGETARCH" = "amd64" ]; then \
      rm /usr/lib/x86_64-linux-gnu/gio/modules/libgiolibproxy.so; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
      rm /usr/lib/aarch64-linux-gnu/gio/modules/libgiolibproxy.so; \
    fi

ARG PROJECT_PATH=/opt/savant
ENV PYTHONUNBUFFERED=1 \
    PROJECT_PATH=$PROJECT_PATH \
    PYTHONPATH=$PROJECT_PATH \
    NUMBA_CACHE_DIR=/cache/numba \
    CUPY_CACHE_DIR=/cache/cupy
WORKDIR $PROJECT_PATH

# python to python3 by default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 10

# set up python venv and install requirements
RUN python3 -m venv /opt/venv --system-site-packages
# TODO: Do we need to extend LD_LIBRARY_PATH? Savant libs can be in package.
ENV PATH="/opt/venv/bin:$PATH" \
    LD_LIBRARY_PATH=/opt/venv/lib:/opt/nvidia/deepstream/deepstream/lib:$LD_LIBRARY_PATH

ARG OPENCV_VERSION=4.12.0
COPY --from=opencv-package-builder /tmp/opencv.tar.gz /tmp/opencv.tar.gz
RUN mkdir -p /tmp/opencv-dist && \
    tar -xf /tmp/opencv.tar.gz -C /tmp/opencv-dist && \
    dpkg -i /tmp/opencv-dist/OpenCV*.deb && \
    rm -rf /tmp/opencv-dist /tmp/opencv.tar.gz

RUN --mount=type=bind,source=requirements/base.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY --from=pyds-package-builder /tmp/pyds-dist /tmp/pyds-dist
RUN python -m pip install --no-cache-dir /tmp/pyds-dist/*.whl && \
    rm -rf /tmp/pyds-dist

RUN --mount=from=savant-boost-builder,source=/libs/savantboost/dist,target=/tmp/dist \
    python -m pip install --no-cache-dir /tmp/dist/*.whl

# install savant-rs
# TODO: Fix SecretsUsedInArgOrEnv for "SAVANT_RS_GH_TOKEN", replace arg with secret
ARG SAVANT_RS_VERSION
ARG SAVANT_RS_GH_REPO=insight-platform/savant-rs
ARG SAVANT_RS_GH_TOKEN
RUN --mount=type=bind,source=local_wheels,target=local_wheels \
    --mount=type=bind,source=utils/install_savant_rs.py,target=utils/install_savant_rs.py \
    ./utils/install_savant_rs.py $SAVANT_RS_VERSION ./tmp && rm -rf ./tmp

COPY --from=savant-rs-ds-builder /tmp/rs-ds-wheels /tmp/rs-ds-wheels
RUN if [ "$DEEPSTREAM_VERSION" = "9.1" ]; then \
      python -m pip install --no-cache-dir --force-reinstall --no-deps \
        /tmp/rs-ds-wheels/deepstream_*.whl; \
    fi && rm -rf /tmp/rs-ds-wheels

RUN --mount=from=savant-meta-builder,source=/libs/gstsavantframemeta/dist,target=/tmp/dist \
    python -m pip install --no-cache-dir /tmp/dist/*.whl

RUN --mount=from=nv-buf-surface-generator-builder,source=/libs/nvbufsurfacegenerator/dist,target=/tmp/dist \
    python -m pip install --no-cache-dir /tmp/dist/*.whl

RUN --mount=from=savant-package-builder,source=/tmp/build/dist,target=/tmp/dist \
    python -m pip install --no-cache-dir /tmp/dist/*.whl

# Fail the image build if the DeepStream/PyDS ABI or Savant's native extensions
# cannot be imported together. This also checks the CUDA-enabled OpenCV package
# used by pyfunc frame access.
RUN --mount=from=cuda-link-stub,source=/tmp/cuda-stubs,target=/tmp/cuda-stubs \
    if [ "$DEEPSTREAM_VERSION" = "9.1" ]; then \
      export LD_LIBRARY_PATH="/tmp/cuda-stubs:$LD_LIBRARY_PATH"; \
    fi && \
    python -c "import cv2, pyds, pygstsavantframemeta, pysavantboost, pynvbufsurfacegenerator, deepstream_nvbufsurface, deepstream_encoders; assert hasattr(cv2.savant, 'createGpuMat'); import savant.deepstream.opencv_utils; import savant.deepstream.pipeline"

# copy headers for cupy NVRTC
COPY --from=builder /usr/local/cuda/include /usr/local/cuda/include

# TODO: install yq?
#ARG YQ_VERSION=4.35.2
#ARG YQ_BINARY=yq_linux_${TARGETARCH}
#RUN wget https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/${YQ_BINARY}.tar.gz -O - \
#    | tar xz && \
#    mv ${YQ_BINARY} /usr/bin/yq

# add framework content
COPY LICENSE .
COPY savant/VERSION .
COPY gst_plugins gst_plugins

COPY adapters/gst/gst_plugins adapters/gst/gst_plugins
RUN rm -f adapters/gst/gst_plugins/python/video_files_sink.py

RUN --mount=type=bind,source=adapters/gst/sources,target=/tmp/adapters/gst/sources \
    --mount=type=bind,source=utils/copy_code.sh,target=/tmp/copy_code.sh \
    /tmp/copy_code.sh /tmp/adapters/gst/sources $PROJECT_PATH/adapters/gst/sources

COPY scripts/uri-input.py scripts/
ENV PATH=$PROJECT_PATH/scripts:$PATH \
    GST_PLUGIN_PATH=$PROJECT_PATH/gst_plugins:$PROJECT_PATH/adapters/gst/gst_plugins \
    LOGLEVEL=info

# Needed a script for healthcheck, because HEALTHCHECK command does not accept ENV
COPY healthcheck.sh .
ENV SAVANT_STATUS_FILEPATH=$PROJECT_PATH/status.txt
HEALTHCHECK --interval=5s --timeout=5s --start-period=30m --retries=3 \
    CMD [ "sh", "/opt/savant/healthcheck.sh" ]

RUN echo 'python3 -c "from savant.utils.welcome import get_welcome_message; print(get_welcome_message())"' >> /etc/bash.bashrc
ENV USE_NEW_NVSTREAMMUX=yes
# To enable nvv4l2h264enc on Jetson
# https://forums.developer.nvidia.com/t/bug-report-nvv4l2h264enc-fails-in-docker-on-jetson-orin-nx-jetpack-6-2-2-root-cause-is-missing-kmod-lsmod/364611/2
ENV AARCH64_IGPU=1

ENTRYPOINT ["python", "-m", "savant.entrypoint"]


# Savant DeepStream adapter container
FROM base AS adapters
ARG TARGETARCH

ARG MEDIAMTX_VERSION="v1.11.3"
RUN mkdir mediamtx && \
    if [ "$TARGETARCH" = "amd64" ]; then \
      wget -qO- "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_amd64.tar.gz" | tar xz -C mediamtx; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
      wget -qO- "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_armv7.tar.gz" | tar xz -C mediamtx; \
    fi

RUN --mount=type=bind,source=adapters/requirements-ds.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

HEALTHCHECK NONE

RUN --mount=type=bind,source=adapters/shared,target=/tmp/adapters/shared \
    --mount=type=bind,source=utils/copy_code.sh,target=/tmp/copy_code.sh \
    /tmp/copy_code.sh /tmp/adapters/shared $PROJECT_PATH/adapters/shared

RUN --mount=type=bind,source=adapters/ds,target=/tmp/adapters/ds \
    --mount=type=bind,source=utils/copy_code.sh,target=/tmp/copy_code.sh \
    /tmp/copy_code.sh /tmp/adapters/ds $PROJECT_PATH/adapters/ds

# To avoid ImportError when Nvidia runtime is not available
RUN rm gst_plugins/python/frame_tag_filter.py
ENV GST_PLUGIN_PATH=$GST_PLUGIN_PATH:$PROJECT_PATH/adapters/ds/gst_plugins

ENTRYPOINT []


# Savant documentation builder
FROM base AS docs

HEALTHCHECK NONE

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        graphviz && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY samples samples

RUN --mount=type=bind,source=docs/requirements.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

ARG USERNAME=container_user
# UID should be set to the same value as host OS UID
ARG USER_UID=1001
ARG USER_GID=$USER_UID
# Create the user
RUN if ! getent group "${USER_GID}" >/dev/null; then \
        groupadd -g "${USER_GID}" "${USERNAME}"; \
    fi
RUN if ! getent passwd "${USER_UID}" >/dev/null; then \
        useradd -m -u "${USER_UID}" -g "${USER_GID}" "${USERNAME}"; \
    fi

RUN chown -R $USER_UID:$USER_GID $PROJECT_PATH
USER ${USER_UID}:${USER_GID}

WORKDIR $PROJECT_PATH/docs

ENTRYPOINT ["make"]
CMD ["clean", "html"]


# Extra x86 container
FROM base AS deepstream-extra
ARG TARGETARCH
ARG TARGETPLATFORM
ARG DEEPSTREAM_VERSION
ARG PACKAGES_URL=https://eu-central-1.linodeobjects.com/savant-data/packages/${TARGETPLATFORM}/ds${DEEPSTREAM_VERSION}
RUN if [ "$DEEPSTREAM_VERSION" = "9.1" ]; then \
      echo 'The optional torch2trt extra image is unavailable for TensorRT 10.16.' >&2; \
      exit 1; \
    fi

# torch, torchvision, torchaudio
RUN python -m pip install --no-cache-dir torch torchvision torchaudio

ENV TORCH_HOME=/cache/models/torch_hub

# torch2trt
ARG TORCH2TRT_VERSION=0.5.0
ARG TORCH2TRT_WHL="torch2trt-${TORCH2TRT_VERSION}-py3-none-any.whl"
RUN wget -nv -P /usr/local/lib/ ${PACKAGES_URL}/libtorch2trt_plugins.so && \
    ldconfig && \
    wget -nv -O ${TORCH2TRT_WHL} ${PACKAGES_URL}/${TORCH2TRT_WHL} && \
    python -m pip install --no-cache-dir tensorrt~=10.9 && \
    python -m pip install --no-cache-dir ${TORCH2TRT_WHL} && \
    python -m pip install --no-cache-dir onnx-graphsurgeon && \
    rm ${TORCH2TRT_WHL}

# pycuda
ARG PYCUDA_VERSION=2024.1
ARG PYCUDA_WHL="pycuda-${PYCUDA_VERSION}-cp312-cp312-linux_x86_64.whl"
RUN wget -nv -O ${PYCUDA_WHL} ${PACKAGES_URL}/${PYCUDA_WHL} && \
    python -m pip install --no-cache-dir ${PYCUDA_WHL} && \
    rm ${PYCUDA_WHL}

# onnx, onnxruntime (use extra-index to get the version with CUDA 12 support)
RUN python -m pip install --no-cache-dir onnx onnxruntime-gpu onnxscript --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/

# cython, polars, scikit-learn, jupyter, etc.
RUN --mount=type=bind,source=requirements/extra.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt


# Extra l4t container
# based on https://github.com/dusty-nv/jetson-containers
FROM base AS deepstream-l4t-extra

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libopenblas-dev \
        libopenmpi-dev \
        openmpi-bin \
        openmpi-common \
        libomp-dev \
        libjpeg-dev \
        libpng-dev \
        zlib1g-dev \
        cmake && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# torch, torchvision, torchaudio
COPY --from=builder /usr/local/cuda-12.6/targets/aarch64-linux/lib/libcupti.* /usr/local/cuda-12.6/targets/aarch64-linux/lib/
RUN python -m pip install torch==2.8.0 torchaudio==2.8.0 torchvision==0.23.0 --index-url=https://pypi.jetson-ai-lab.io/jp6/cu126

# set the CUDA architectures that torch extensions get built for
# Nano/TX1 = 5.3, TX2 = 6.2, Xavier = 7.2, Orin = 8.7
ARG TORCH_CUDA_ARCH_ARGS="8.7"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_ARGS} \
    TORCH_HOME=/cache/models/torch_hub

# torch2trt
ARG TORCH2TRT_VERSION=0.5.0
ARG TORCH2TRT_WHL="torch2trt-${TORCH2TRT_VERSION}-py3-none-any.whl"
RUN wget -nv -P /usr/local/lib/ ${PACKAGES_URL}/libtorch2trt_plugins.so && \
    ldconfig && \
    wget -nv -O ${TORCH2TRT_WHL} ${PACKAGES_URL}/${TORCH2TRT_WHL} && \
    python -m pip install --no-cache-dir tensorrt && \
    python -m pip install --no-cache-dir ${TORCH2TRT_WHL} && \
    python -m pip install --no-cache-dir nvidia-pyindex && \
    python -m pip install --no-cache-dir onnx-graphsurgeon && \
    rm ${TORCH2TRT_WHL}

# pycuda
ARG PYCUDA_VERSION=2024.1
ARG PYCUDA_WHL="pycuda-${PYCUDA_VERSION}-cp310-cp310-linux_aarch64.whl"
RUN wget -nv -O ${PYCUDA_WHL} ${PACKAGES_URL}/${PYCUDA_WHL} && \
    python -m pip install --no-cache-dir ${PYCUDA_WHL} && \
    rm ${PYCUDA_WHL}

# onnx, onnxruntime
# https://elinux.org/Jetson_Zoo#ONNX_Runtime
ARG ORT_URL="https://nvidia.box.com/shared/static/i7n40ki3pl2x57vyn4u7e9asyiqlnl7n.whl"
ARG ORT_WHL="onnxruntime_gpu-1.17.0-cp310-cp310-linux_aarch64.whl"
RUN wget -nv -O ${ORT_WHL} ${ORT_URL} && \
    python -m pip install --no-cache-dir onnx ${ORT_WHL}

# cython, polars, scikit-learn, jupyter, etc.
RUN --mount=type=bind,source=requirements/extra.txt,target=/tmp/requirements.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt
